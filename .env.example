APP_ENV=production
APP_URL=https://accounts2026.weddingsbymark.uk
ALLOWED_HOSTS=accounts2026.weddingsbymark.uk,192.168.24.10,localhost,127.0.0.1
CORS_ORIGINS=https://accounts2026.weddingsbymark.uk,http://192.168.24.10:30053
SESSION_SECRET=generate-a-long-random-value
SESSION_HOURS=12
COOKIE_SECURE=false
ADMIN_EMAIL=mark@perfectweddingsbymark.uk
ADMIN_PASSWORD=choose-a-new-strong-password
MONGO_URL=mongodb://accountsadmin:database-password@mongodb:27017/?authSource=admin
DB_NAME=weddings_by_mark_accounts_2026
STORAGE_ROOT=/app/storage
MAX_RESTORE_MB=250
GEMINI_API_KEY=
BOOKING_INTEGRATION_ENABLED=false
BOOKING_INTEGRATION_KEY=replace-with-the-same-64-character-secret-used-by-booking

# Optional HMRC test workspace. No production filing is supported.
HMRC_SANDBOX_ENABLED=false
HMRC_ENVIRONMENT=sandbox
HMRC_SANDBOX_CLIENT_ID=
HMRC_SANDBOX_CLIENT_SECRET=
HMRC_TOKEN_ENCRYPTION_KEY=
HMRC_SANDBOX_NINO=
HMRC_SANDBOX_TEST_USER_CONFIRMED=false
HMRC_VENDOR_PUBLIC_IP=
HMRC_TRUST_EDGE_HEADERS=false
